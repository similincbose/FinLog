CREATE TABLE payment_method (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    sort_order INTEGER NOT NULL,
    is_default INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM payment_method ORDER BY sort_order ASC;

selectById:
SELECT * FROM payment_method WHERE id = ?;

selectCount:
SELECT COUNT(*) FROM payment_method;

insert:
INSERT INTO payment_method (name, sort_order, is_default)
VALUES (?, ?, ?);

update:
UPDATE payment_method
SET name = ?
WHERE id = ?;

deleteById:
DELETE FROM payment_method WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();
